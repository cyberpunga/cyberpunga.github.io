{
  "id": "photosets",
  "label": "Fotogalería",
  "pluralLabel": "Fotogalerías",
  "description": "Conjuntos de imágenes al estilo photoset.",
  "route": "fotogalerias",
  "bodyLabel": "Caption",
  "bodyPlaceholder": "Describe la serie o inserta las imágenes en Markdown.",
  "sort": {
    "field": "date",
    "direction": "desc"
  },
  "fields": [
    {
      "name": "date",
      "label": "Fecha",
      "type": "date",
      "required": true
    },
    {
      "name": "image_urls",
      "label": "Imágenes",
      "type": "list",
      "required": false,
      "placeholder": "images/uno.jpg, images/dos.jpg"
    },
    {
      "name": "alt_text",
      "label": "Texto alternativo",
      "type": "textarea",
      "required": false,
      "placeholder": "Descripción accesible de la serie."
    },
    {
      "name": "layout",
      "label": "Layout",
      "type": "select",
      "required": false,
      "options": ["Grid", "Stack", "Mosaic"]
    },
    {
      "name": "credit",
      "label": "Crédito",
      "type": "text",
      "required": false
    },
    {
      "name": "tags",
      "label": "Tags",
      "type": "tags",
      "required": false,
      "placeholder": "photoset, galería"
    }
  ]
}
